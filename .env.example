# =================================================================
# PhishGuard AI — Production Deployment Environment Template
# =================================================================
#
# ARCHITECTURE:
#   VERCEL FRONTEND  ---> (Public HTTPS) ---> FASTAPI BACKEND ---> Threat Providers
#
# DO NOT COMMIT REAL API KEYS OR PASSWORDS TO GIT.
# =================================================================

# -----------------------------------------------------------------
# 1. FASTAPI BACKEND HOST ENVIRONMENT VARIABLES
#    (Deploy to Render, Railway, Fly.io, Cloud Run, or VPS)
# -----------------------------------------------------------------

# Application & Security
ENVIRONMENT=production
SECRET_KEY=change-this-to-a-secure-random-32-character-string
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (CORS)
# Add your production Vercel frontend URL (comma-separated if multiple)
FRONTEND_ORIGINS=https://your-phishguard-project.vercel.app,http://localhost:3000

# Database
# SQLite default for local, or PostgreSQL connection string for cloud production
DATABASE_URL=sqlite:///./phishguard.db

# Threat Intelligence Providers (Backend-Only Secrets)
VIRUS_TOTAL_API_KEY=your_virustotal_api_v3_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_v2_api_key_here
OTX_API_KEY=your_alienvault_otx_api_key_here

# Splunk Enterprise / Cloud SIEM (HTTP Event Collector)
# For local Windows lab: https://127.0.0.1:8088/services/collector
# For cloud SIEM: https://your-splunk-cloud-domain:8088/services/collector
SPLUNK_HEC_URL=https://127.0.0.1:8088/services/collector
SPLUNK_HEC_TOKEN=your_splunk_hec_token_guid_here
SPLUNK_INDEX=phishguard
SPLUNK_SOURCETYPE=phishguard:scan
SPLUNK_VERIFY_TLS=false

# Optional AI Explanation Service
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local Forensics Tools (Local Windows Lab only)
YARA_RULES_PATH=
TSHARK_PATH=

# -----------------------------------------------------------------
# 2. VERCEL FRONTEND ENVIRONMENT VARIABLES
#    (Configure in Vercel Dashboard -> Settings -> Environment Variables)
# -----------------------------------------------------------------
# Point this to your publicly accessible FastAPI backend URL:
# VITE_API_URL=https://your-backend-api.onrender.com/api
