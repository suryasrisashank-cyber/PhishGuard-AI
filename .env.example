# PhishGuard AI 3.0 — Environment Configuration Template
# All external services are optional. Missing keys automatically enter defensive NOT CONFIGURED / UNAVAILABLE mode.

# Database
DATABASE_URL=sqlite:///./phishguard.db

# Frontend API URL (leave empty for local proxy, or set to your public HTTPS backend URL)
VITE_API_URL=http://127.0.0.1:8000/api

# Security & Session
SECRET_KEY=change-me-to-a-secure-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SIEM / Splunk Integration (HTTP Event Collector)
SPLUNK_HOST=https://splunk-server.internal:8088
SPLUNK_HEC_URL=https://splunk-server.internal:8088
SPLUNK_HEC_TOKEN=your-splunk-hec-token-here
SPLUNK_INDEX=phishguard
SPLUNK_SOURCETYPE=phishguard:scan
SPLUNK_VERIFY_TLS=true

# Threat Intelligence Providers
VIRUS_TOTAL_API_KEY=your-virustotal-api-key-here
ABUSEIPDB_API_KEY=your-abuseipdb-api-key-here
OTX_API_KEY=your-alienvault-otx-api-key-here

# Local Forensic Tools
YARA_RULES_PATH=./rules/phishing_rules.yar
TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe

# AI Explanation Assistant (Optional, non-authoritative)
GEMINI_API_KEY=your-gemini-api-key-here

# Logging
LOG_LEVEL=INFO
